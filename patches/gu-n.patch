+                static const bool gn = [] { const char* v = std::getenv("STRATA_GU_N"); return v == nullptr || v[0] != '0'; }();
+                if (gn) native_gu_fused_kernel<22, true><<<gl, 256, sh, s>>>(grp_ptr, grp_start, n_groups, ent_tok, X, L, hq);
+                else native_gu_fused_kernel<22><<<gl, 256, sh, s>>>(grp_ptr, grp_start, n_groups, ent_tok, X, L, hq);
+                break;
+            }
         }
