+void native_qsa_gate_quantize_q8_1(const float* attn, const float* q_full, void* x_q8_1, int rows, int head_dim,
+                                   void* stream) {
+    validate_pointer(attn);
+    validate_pointer(q_full);
+    validate_pointer(x_q8_1);
+    validate_stream(stream);
+    if (rows <= 0 || head_dim <= 0 || head_dim % 32 != 0) throw std::invalid_argument("native QSA gate + q8_1: bad shape");
+    const int n_total = rows * head_dim;
+    const unsigned blocks = unsigned((std::size_t(n_total) + QUANT_THREADS - 1) / QUANT_THREADS);
+    native_qsa_gate_quantize_q8_1_kernel<<<blocks, QUANT_THREADS, 0, static_cast<cudaStream_t>(stream)>>>(
+        attn, q_full, static_cast<Q81Block*>(x_q8_1), n_total, head_dim);
+    launch_check();
+}
