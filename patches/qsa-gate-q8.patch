+// rdna3-moe-tuning STRATA_QSA_GATE_Q8: native_qsa.cu's gate (attn * sigmoid of the gate half of the q|gate rows) and
+// native_quantize_q8_1_kernel in one launch - both are one thread an element in blocks of QUANT_THREADS, and the
+// expressions are theirs (the product rounded before the block sum, as when it was read back from memory): the same bits
+__launch_bounds__(QUANT_THREADS, 1)
+__global__ void native_qsa_gate_quantize_q8_1_kernel(const float* __restrict__ attn, const float* __restrict__ q_full,
+                                                     Q81Block* __restrict__ y, int n_total, int head_dim) {
+    const int i = int(blockIdx.x) * QUANT_THREADS + int(threadIdx.x);
+    if (i >= n_total) return; // n_total is a multiple of 32: only whole warps return.
+    const std::size_t head = std::size_t(i) / head_dim, channel = std::size_t(i) % head_dim;
+    const float raw = q_full[head * 2 * head_dim + head_dim + channel];
+    const float sigmoid = 1.0f / (1.0f + expf(-raw));
+    const float xi = __fmul_rn(attn[i], sigmoid);
+    const float amax = warp_max(fabsf(xi));
+    const float sum = warp_sum(xi);
+    const float d = q8_1_finite(amax / 127.0f);
+    const int8_t q = q8_1_quant(xi, d, amax);
+    y[i / Q8K].qs[i % Q8K] = q;
+    if (i % Q8K == 0) y[i / Q8K].ds = q8_1_ds(d, sum);
+}
