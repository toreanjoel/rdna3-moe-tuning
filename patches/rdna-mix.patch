+// rdna3-moe-tuning STRATA_RDNA_MIX: two formats in one launch, each row exactly its own RDNA kernel's (the default unroll:
+// IQ4_XS 2 as kq_launch, the rest stock)
+template <int F, int NC>
+__device__ __forceinline__ void mix_row(int row, const uint8_t* w, const Q81* x, float* y, int n_in, int n_out) {
+    if constexpr (F == 14) rdna_q6k_body<NC>(row, w, x, y, n_in, n_out, nullptr, nullptr, 0);
+    else rdna_kq_body<F, NC, (F == 23 ? 2 : (NC <= 2 ? 5 : NC <= 4 ? 3 : 2))>(row, w, x, y, n_in, n_out, nullptr, nullptr, 0);
+}
+template <int F1, int F2, int NC>
+__global__ void __launch_bounds__(256) rdna_mix_kernel(const uint8_t* __restrict__ w1, float* __restrict__ y1, int n1,
+                                                       const uint8_t* __restrict__ w2, float* __restrict__ y2, int n2,
+                                                       const Q81* __restrict__ x, int n_in) {
+    const int row = blockIdx.x * 8 + (threadIdx.x >> 5);
+    if (row < n1) mix_row<F1, NC>(row, w1, x, y1, n_in, n1);
+    else mix_row<F2, NC>(row - n1, w2, x, y2, n_in, n2);
+}
+template <int F1, int F2>
+void mix_launch(const uint8_t* w1, float* y1, int n1, const uint8_t* w2, float* y2, int n2, const Q81* x, int n_in, int nc, cudaStream_t s) {
+    const unsigned blocks = (unsigned) (n1 / 8 + (n2 + 7) / 8);
+    switch (nc) {
+        case 1: rdna_mix_kernel<F1, F2, 1><<<blocks, 256, 0, s>>>(w1, y1, n1, w2, y2, n2, x, n_in); break;
+        case 2: rdna_mix_kernel<F1, F2, 2><<<blocks, 256, 0, s>>>(w1, y1, n1, w2, y2, n2, x, n_in); break;
+        case 3: rdna_mix_kernel<F1, F2, 3><<<blocks, 256, 0, s>>>(w1, y1, n1, w2, y2, n2, x, n_in); break;
+        case 4: rdna_mix_kernel<F1, F2, 4><<<blocks, 256, 0, s>>>(w1, y1, n1, w2, y2, n2, x, n_in); break;
+        default: rdna_mix_kernel<F1, F2, 5><<<blocks, 256, 0, s>>>(w1, y1, n1, w2, y2, n2, x, n_in); break;
+    }
+}
