+// rdna3-moe-tuning STRATA_RDNA_MIX (default on, =0 off): see mix_row.  sweep24 (8K): verify -0.32 ms a window (18.53 -> 18.21);
+// quality25: top-1 100%, KL 0.00000, PPL 4.041 vs 4.040 (not bitwise vs the stock Q4_K / Q5_K wave kernels at 1-2 columns)
+bool rdna_mix_enabled() {
+    static const bool on = [] { const char* v = std::getenv("STRATA_RDNA_MIX"); return v == nullptr || v[0] != '0'; }();
+    return on;
+}
+bool rdna_mmvq_mix(int t1, const void* w1, float* y1, int n1, int t2, const void* w2, float* y2, int n2, const void* xq,
+                   int n_in, int ncols, void* stream) {
+    if (!rdna_mix_enabled() || t1 == t2 || n_in % QK != 0 || n1 % 8 != 0 || ncols < 1 || ncols > 5) return false;
+    const auto* a = static_cast<const uint8_t*>(w1);
+    const auto* b = static_cast<const uint8_t*>(w2);
+    const auto* x = static_cast<const Q81*>(xq);
+    cudaStream_t s = (cudaStream_t) stream;
+    switch (t1) {
+        case 12: return mix_f2<12>(t2, a, y1, n1, b, y2, n2, x, n_in, ncols, s);
+        case 13: return mix_f2<13>(t2, a, y1, n1, b, y2, n2, x, n_in, ncols, s);
+        case 14: return mix_f2<14>(t2, a, y1, n1, b, y2, n2, x, n_in, ncols, s);
+        case 23: return mix_f2<23>(t2, a, y1, n1, b, y2, n2, x, n_in, ncols, s);
+        default: return false;
+    }
+}
