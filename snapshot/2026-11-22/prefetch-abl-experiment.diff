+// rdna3-moe-tuning STRATA_PREFETCH: read weight ranges once so they sit in the 96 MB Infinity Cache (MALL) before their GEMV
+// runs (tools/mallbench.hip on gfx1100: a 32-64 MB read runs at 1.2-2.0 TB/s warm vs 0.7-0.8 cold; 24 blocks pull ~330 GB/s).
+// Pure loads, nothing written (the sink store never happens), so it changes no output.
+namespace {
+constexpr int kPrefetchMax = 16;   // as native_mmvq.hpp
+struct PfArgs { const uint4* p[kPrefetchMax]; unsigned n16[kPrefetchMax]; int n; };
+__global__ void __launch_bounds__(256) mall_prefetch_kernel(PfArgs a, unsigned* sink) {
+    uint32_t acc = 0;
+    const unsigned stride = gridDim.x * blockDim.x;
+    for (int r = 0; r < a.n; ++r) {
+        const uint4* __restrict__ p = a.p[r];
+        for (unsigned i = blockIdx.x * blockDim.x + threadIdx.x; i < a.n16[r]; i += stride) {
+            const uint4 v = p[i];
+            acc ^= v.x ^ v.y ^ v.z ^ v.w;
+        }
+    }
+    if (acc == 0x9e3779b9u && sink) *sink = acc;
+}
+}  // namespace
+void mall_prefetch(const void* const* ptrs, const unsigned long long* bytes, int n, int grid, void* stream) {
+    PfArgs a{}; int k = 0;
+    for (int i = 0; i < n && k < kPrefetchMax; ++i)
+        if (ptrs[i] != nullptr && bytes[i] >= 16) { a.p[k] = (const uint4*) ptrs[i]; a.n16[k] = (unsigned) (bytes[i] / 16); ++k; }
+    a.n = k;
+    if (k == 0) return;
+    mall_prefetch_kernel<<<(unsigned) (grid > 0 ? grid : 24), 256, 0, (cudaStream_t) stream>>>(a, nullptr);
+}
+
+// rdna3-moe-tuning STRATA_PREFETCH=4: the persistent prefetcher (see verify.cpp g_prefetch).  table: n_layers PfArgs entries.
+namespace {
+__global__ void __launch_bounds__(256) mall_prefetcher_kernel(const PfArgs* __restrict__ table, int n_layers,
+                                                              const volatile unsigned* seq, int dist, unsigned long long timeout) {
+    __shared__ int go;
+    uint32_t acc = 0;
+    const unsigned stride = gridDim.x * blockDim.x;
+    for (int L = 0; L < n_layers; ++L) {
+        const unsigned need = L >= dist ? (unsigned) (L - dist + 1) : 0u;
+        if (threadIdx.x == 0) {
+            const unsigned long long t0 = wall_clock64();
+            int ok = 1;
+            while (*seq < need) {
+                if (wall_clock64() - t0 > timeout) { ok = 0; break; }
+                __builtin_amdgcn_s_sleep(4);
+            }
+            go = ok;
+        }
+        __syncthreads();
+        if (!go) break;
+        const int n = table[L].n;
+        for (int r = 0; r < n; ++r) {
+            const uint4* __restrict__ p = table[L].p[r];
+            const unsigned m = table[L].n16[r];
+            for (unsigned i = blockIdx.x * blockDim.x + threadIdx.x; i < m; i += stride) {
+                const uint4 v = p[i];
+                acc ^= v.x ^ v.y ^ v.z ^ v.w;
+            }
+        }
+        __syncthreads();
+    }
+    if (acc == 0x9e3779b9u && threadIdx.x == 1023) go = (int) acc;   // keeps the loads; never true for 256 threads
+}
+}  // namespace
+unsigned long long mall_pf_entry_bytes() { return sizeof(PfArgs); }
+void mall_pf_fill(void* entry, const void* const* ptrs, const unsigned long long* bytes, int n) {
+    PfArgs a{}; int k = 0;
+    for (int i = 0; i < n && k < kPrefetchMax; ++i)
+        if (ptrs[i] != nullptr && bytes[i] >= 16) { a.p[k] = (const uint4*) ptrs[i]; a.n16[k] = (unsigned) (bytes[i] / 16); ++k; }
+    a.n = k;
+    *static_cast<PfArgs*>(entry) = a;
+}
+void mall_prefetcher(const void* table, int n_layers, const unsigned* seq, int dist, int grid, double timeout_ms, void* stream) {
+    mall_prefetcher_kernel<<<(unsigned) (grid > 0 ? grid : 24), 256, 0, (cudaStream_t) stream>>>(
+        static_cast<const PfArgs*>(table), n_layers, seq, dist, (unsigned long long) (timeout_ms * 1e5));   // 100 MHz wall clock
+}
 }  // namespace strata::kernels
